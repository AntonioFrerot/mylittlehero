# Base PostgreSQL (obligatoire en production sur Vercel)
# Vercel Postgres injecte POSTGRES_URL ; Neon/Supabase utilisent DATABASE_URL.
DATABASE_URL=
POSTGRES_URL=

# Secret pour signer les cookies de session (obligatoire en production)
AUTH_SECRET=

# Stockage des photos de personnages en production (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# OpenAI (génération d'histoires)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STORY_MODEL=

# Génération d'histoires en arrière-plan
STORY_GENERATION_SECRET=
STORY_GENERATION_MODE=mock

# URL publique du site (recommandé pour Stripe : redirections après paiement)
NEXT_PUBLIC_APP_URL=

# Stripe — paiements sur /achat et abonnements sur /creer
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs créés dans le tableau de bord Stripe (mode test ou live)
STRIPE_PRICE_FILM_5MIN=
STRIPE_PRICE_FILM_10MIN=
STRIPE_PRICE_PACK_3FILMS=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_YEARLY=
