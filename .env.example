# Base PostgreSQL (obligatoire en production sur Vercel)
# Vercel Postgres injecte POSTGRES_URL ; Neon/Supabase utilisent DATABASE_URL.
DATABASE_URL=
POSTGRES_URL=

# Secret pour signer les cookies de session (obligatoire en production)
AUTH_SECRET=

# Stockage des photos en production (Vercel Blob)
# Ancien mode : token manuel. Nouveau mode Vercel Storage : BLOB_STORE_ID (auto sur Vercel).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# OpenAI (génération d'histoires)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STORY_MODEL=

# Génération d'histoires en arrière-plan
STORY_GENERATION_SECRET=
STORY_GENERATION_MODE=mock

# URL publique du site (recommandé pour Stripe : redirections après paiement)
NEXT_PUBLIC_APP_URL=

# Mentions légales — micro-entreprise (à copier dans .env.local et adapter)
# Nom officiel : en général « Prénom NOM » (comme sur votre attestation URSSAF / avis de situation INSEE)
# LEGAL_COMPANY_NAME=Antonio FREROT
# LEGAL_FORM=Micro-entreprise
# LEGAL_ADDRESS=12 rue Exemple, 75001 Paris, France
# LEGAL_SIRET=12345678900012
# LEGAL_PUBLISHER_DIRECTOR=Antonio FREROT
# LEGAL_PHONE=+33 6 12 34 56 78
# Optionnel — déjà prérempli par défaut pour une micro-entreprise en franchise de TVA :
# LEGAL_SHARE_CAPITAL=Non applicable (micro-entreprise)
# LEGAL_RCS=Non inscrit au RCS (activité non commerciale ou micro-entrepreneur)
# LEGAL_VAT_NUMBER=TVA non applicable, article 293 B du CGI
# Médiateur de la consommation agréé (obligatoire B2C) — ex. MEDICYS pour le numérique :
# LEGAL_MEDIATOR_NAME=MEDICYS
# LEGAL_MEDIATOR_URL=https://www.medicys.fr
# LEGAL_MEDIATOR_CONTACT=contact@medicys.fr
LEGAL_COMPANY_NAME=
LEGAL_FORM=Micro-entreprise
LEGAL_SHARE_CAPITAL=
LEGAL_ADDRESS=
LEGAL_SIRET=
LEGAL_RCS=
LEGAL_VAT_NUMBER=
LEGAL_PUBLISHER_DIRECTOR=
LEGAL_PHONE=
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=
LEGAL_MEDIATOR_CONTACT=

# Stripe — paiements sur /achat et abonnements sur /creer
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs créés dans le tableau de bord Stripe (mode test ou live)
STRIPE_PRICE_FILM_5MIN=
STRIPE_PRICE_FILM_10MIN=
STRIPE_PRICE_PACK_3FILMS=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_YEARLY=
STRIPE_PRICE_UNLIMITED_MONTHLY=
STRIPE_PRICE_UNLIMITED_YEARLY=
